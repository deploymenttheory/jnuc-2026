# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

# Editors / IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Node tooling (reveal.js, Slidev, Marp, esbuild, etc.)
node_modules/
.npm/
.cache/
.parcel-cache/
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Environment / secrets
.env
.env.*
!.env.example

# Build output
# NOTE: if the deck is published from dist/ via GitHub Pages, remove these two
# lines — Pages serves what is committed.
dist/
build/

# Presentation exports (regenerate from source rather than committing)
*.pdf
*.pptx
export/
exports/

# The deck downloads are the exception: GitHub runners have no Keynote and a
# Linux capture would render the decks in substitute fonts, so
# tools/build-downloads.mjs builds both formats on a Mac by hand and both ARE
# committed - the deploy only syncs them. Rebuild and commit them alongside any
# deck edit. template.key (the Jamf-supplied JNUC template) is committed as the
# canonical style reference.
!presentations/*/*.pptx

# Speaker/scratch material that should not ship
*.local.html
notes.local.md
scratch/

# Large media working files (commit optimised assets, not the originals)
*.mov
*.mp4
*.psd
*.ai
*.sketch

# A finished, encoded cut is the exception, in the same way the deck downloads
# are: the rule above keeps camera originals and working files out, while a
# delivery-ready video under presentations/_shared/ is a shipped asset that the
# S3 sync serves straight from there.
!presentations/_shared/*.mp4

# LLM Created Folders
.claude/